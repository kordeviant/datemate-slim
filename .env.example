# Server Config
PORT=3000
NODE_ENV=development
TRUST_PROXY="loopback"

# Rate Limiting (@nestjs/throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Media & Assets Config (Storage independent from public URL; domain changes without modifying stored data)
ASSET_BASE_URL="https://localhost:3000"
STORAGE_DRIVER=local
UPLOADS_DIR="uploads"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/datemate_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Recommended Candidate Cache TTL (seconds: 86400 = 1 day)
RECOMMENDED_CACHE_TTL=86400

# Documentation & Rules Security (/docs, /docs/rules)
DOCS_IP_WHITELIST_ENABLED=false
DOCS_ALLOWED_IPS="127.0.0.1,::1"
DOCS_AUTH_ENABLED=true
DOCS_USERNAME="admin"
DOCS_PASSWORD="datemate_docs_password_2026"

# Internal API Key (Server-to-Server, e.g. Get Device Token)
DEVICE_TOKEN_API_KEY="datemate_device_token_api_key_2026"

# JWT Secrets
JWT_ACCESS_SECRET="datemate_jwt_access_super_secret_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="datemate_jwt_refresh_super_secret_key_2026"
JWT_REFRESH_EXPIRES_IN="30d"

# Play Integrity
GOOGLE_PLAY_PACKAGE_NAME="com.dmate.datemate"

# Apple Sign-In (optional client ID / iOS bundle identifier audience restriction)
APPLE_CLIENT_ID="com.dmate.datemate"

# SMTP Mail Settings (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE=false
SMTP_FROM='"DateMate" <no-reply@appdatemate.com>'

# Push Notification Domain (Consolidated In-Process + FCM Provider)
# Set FIREBASE_CREDENTIALS_PATH to service-account.json or raw JSON in FIREBASE_SERVICE_ACCOUNT.
# If unset, FCM operates in mock simulation mode (logs notification dispatches without errors).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT=
PUSH_NOTIFICATION_API_KEY="datemate_push_notification_api_key_2026"
# Optional legacy fallback if routing through external standalone push service:
PUSH_NOTIFICATION_BASE_URL="http://localhost:4000"

# Optional RabbitMQ Queue for Asynchronous Push Dispatch
RABBITMQ_ENABLED=false
RABBITMQ_URI="amqp://guest:guest@localhost:5672"
RABBITMQ_PUSH_QUEUE="push_notifications"

# Apache Cassandra (Real-Time Chat & Timeline Storage)
CASSANDRA_CONTACT_POINTS="localhost"
CASSANDRA_LOCAL_DATA_CENTER="datacenter1"
CASSANDRA_KEYSPACE="datemate_chat"
CASSANDRA_USER=
CASSANDRA_PASSWORD=
CASSANDRA_READ_TIMEOUT_MS=12000

# Chat Media Storage & Attachments
CHAT_STORAGE_DRIVER="local"
CHAT_UPLOADS_DIR="uploads/chat"
CHAT_STORAGE_BASE_URL=
